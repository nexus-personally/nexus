{
  "$schema": "../../node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/*.css",
          "/manifest.webmanifest",
          "/favicon.svg",
          "/split/icon-192.png",
          "/split/icon-512.png",
          "/split/icon-maskable-512.png",
          "/split/apple-touch-icon.png"
        ]
      }
    },
    {
      "name": "application-code",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/*.js"]
      }
    },
    {
      "name": "split-static-assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/split/**"]
      }
    }
  ]
}

NODE_ENV=development
API_PORT=3000
WEB_ORIGIN=http://localhost:4200,http://127.0.0.1:4200
SPLIT_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
SPLIT_CSRF_SECRET=replace-with-at-least-32-random-characters
SPLIT_FX_PROVIDER=frankfurter
SPLIT_FX_BASE_URL=https://api.frankfurter.dev/v2
SPLIT_FX_CACHE_SECONDS=21600
PUBLIC_BASE_URL=http://localhost:4200
PERSISTENCE=postgres
ADMIN_ACCESS_TOKEN=

# Use DATABASE_URL in production/cloud. Local development can use the fields below.
# DATABASE_URL=postgresql://nexus:nexus_dev_only@localhost:5432/nexus
POSTGRES_SSL=false

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus_dev_only

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=nexus-local
S3_ACCESS_KEY=nexus
S3_SECRET_KEY=nexus_dev_only

# Mahjong room voice (LiveKit). These values match docker-compose.local.yml.
# On phones, replace localhost with this computer's LAN IP address.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

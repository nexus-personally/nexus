NODE_ENV=development
API_PORT=3000
WEB_ORIGIN=http://localhost:4200,http://127.0.0.1:4200
PUBLIC_BASE_URL=http://localhost:4200
PERSISTENCE=postgres

# Use DATABASE_URL in production/cloud. Local development can use the fields below.
# DATABASE_URL=postgresql://nexus:nexus_dev_only@localhost:5432/nexus
POSTGRES_SSL=false

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus_dev_only

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=nexus-local
S3_ACCESS_KEY=nexus
S3_SECRET_KEY=nexus_dev_only
